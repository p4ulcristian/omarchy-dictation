#!/usr/bin/env bash
# Download the speech model, Qwen3-ASR-1.7B (3.9 GB), into
# ~/.local/share/iris-dictation/models/qwen3-asr-1.7b.
set -euo pipefail
cd "$(dirname "$(dirname "$(readlink -f "$0")")")"

REPO="Qwen/Qwen3-ASR-1.7B-hf"
DEST="$HOME/.local/share/iris-dictation/models/qwen3-asr-1.7b"

echo "Fetching $REPO into $DEST ..."
mkdir -p "$DEST"
.venv/bin/python - "$REPO" "$DEST" <<'PY'
import sys
from huggingface_hub import snapshot_download
repo, dest = sys.argv[1:]
snapshot_download(repo, allow_patterns=["*.json", "*.jinja", "*.safetensors"], local_dir=dest)
PY
echo "Model installed in $DEST"
du -sh "$DEST"
